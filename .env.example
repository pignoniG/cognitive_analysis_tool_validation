# Copy to .env (docker compose reads it) and edit. Never commit .env.

# The password for the page and every save (HTTP Basic: any user name). Leave empty only behind a proxy that
# already asks for one. Use a long random one:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
VALIDATION_PASSWORD=

# Where the sessions are kept on the host: a folder outside the image, so a new deployment never touches them.
# It must be writable by the container's user (uid 10001):  mkdir -p data && sudo chown 10001:10001 data
DATA_PATH=./data
DATA_UID=10001
DATA_GID=10001

# The port published on the host's loopback (127.0.0.1) only, for an SSH tunnel or a proxy on the host.
VALIDATION_PORT=8765

# For docker-compose.proxy.yml: the Docker network the existing nginx is on (docker network ls).
PROXY_NETWORK=
